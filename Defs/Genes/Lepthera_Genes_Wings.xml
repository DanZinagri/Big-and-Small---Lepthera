        <drawData>
          <defaultData>
            <layer>10</layer>
            <offset>(0, 0, -0.16)</offset>
          </defaultData>
          <dataSouth>
            <layer>-1</layer>
          </dataSouth>
          <dataNorth>
            <layer>55</layer>
          </dataNorth>
          <dataEast>
            <offset>(-0.13, 0, 0.09)</offset>
          </dataEast>
        </drawData>
        <conditionalGraphics>
          <texturePaths>
            <li>Lepthera/Wings/leptherawings_light</li>
          </texturePaths>
          <colorA>
            <hairColor>true</hairColor>
          </colorA>
          <colorB>
            <color>(0.95, 0.94, 0.90)</color>
          </colorB>
          <colorC>
