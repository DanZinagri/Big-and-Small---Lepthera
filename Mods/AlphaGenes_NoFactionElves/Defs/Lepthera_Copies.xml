<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Copies of Faction - Elves' (ICC.FOV.ELVES) Skin_DarkPurple and Hair_AshBrown for Mycoth.
       Loaded only with Alpha Genes (Mycoth) and without Faction - Elves (loadFolders.xml); this
       folder's patch puts them on Mycoth. With Elves, Mycoth list the originals (MayRequire). -->
  <GeneDef ParentName="GeneSkinColorOverride">
    <defName>Lepthera_Skin_DarkPurple</defName>
    <label>dark purple skin</label>
    <labelShortAdj>purple</labelShortAdj>
    <description>Carriers of this gene produce a pigment that gives their skin a dark purple color.</description>
    <skinColorOverride>(80, 70, 80)</skinColorOverride>
    <displayOrderInCategory>85</displayOrderInCategory>
    <symbolPack>
      <prefixSymbols>
        <li><symbol>purp</symbol></li>
        <li><symbol>grape</symbol></li>
      </prefixSymbols>
    </symbolPack>
  </GeneDef>

  <GeneDef ParentName="GeneHairColorBase">
    <defName>Lepthera_Hair_AshBrown</defName>
    <label>ash-brown hair</label>
    <hairColorOverride>(0.45, 0.3, 0.3)</hairColorOverride>
    <selectionWeight>1.5</selectionWeight>
    <displayOrderInCategory>120</displayOrderInCategory>
  </GeneDef>

</Defs>
