<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Alpha Genes (Mycoth) without Faction - Elves: our dark purple skin and ash-brown hair.
       The copies are defined in this same folder, so a xenotype only ever lists them when they
       exist. With the original mod active, the xenotype lists its gene instead (MayRequire). -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/XenotypeDef[defName="Lepthera_Mycoth"]/genes</xpath>
    <value>
      <li>Lepthera_Skin_DarkPurple</li>
      <li>Lepthera_Hair_AshBrown</li>
    </value>
  </Operation>

</Patch>
