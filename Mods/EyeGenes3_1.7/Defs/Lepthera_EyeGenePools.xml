<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<!-- EyeGenes3 (lucius.eyegenes3) eye colour pools. EyeGenes3 gives a generated (non-newborn) pawn of
	     the xenotype one gene from its pool, replacing conflicting eye colour endogenes. Xenotypes are
	     looked up by name and skipped when missing, so Mycoth/Lunaveth need no extra gate.
	     glowingGenes are used instead of genes only when the player enables EyeGenes3's glowing eye genes
	     and "use mod-provided glowing pools" (off by default). 1.6's EyeGenes3 has no glowing genes;
	     see Mods/EyeGenes3_1.6. -->

	<!-- regal gold and amber -->
	<EyeGenes3.XenotypeEyeGenePoolDef>
		<defName>EG3_Lepthera_Aurelith</defName>
		<xenotypeDefName>Lepthera_Aurelith</xenotypeDefName>
		<genes>
			<li><gene>Eyes_Golden</gene><weight>1</weight></li>
			<li><gene>Eyes_BrightYellow</gene><weight>1</weight></li>
			<li><gene>Eyes_DarkYellow</gene><weight>1</weight></li>
			<li><gene>Eyes_LightBrown</gene><weight>1</weight></li>
			<li><gene>Eyes_Brown</gene><weight>1</weight></li>
		</genes>
		<glowingGenes>
			<li><gene>Eyes_GoldenGlow</gene><weight>1</weight></li>
			<li><gene>Eyes_BrightYellowGlow</gene><weight>1</weight></li>
			<li><gene>Eyes_DarkYellowGlow</gene><weight>1</weight></li>
			<li><gene>Eyes_LightBrownGlow</gene><weight>1</weight></li>
			<li><gene>Eyes_BrownGlow</gene><weight>1</weight></li>
		</glowingGenes>
	</EyeGenes3.XenotypeEyeGenePoolDef>

