<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Loaded only with Genes & More (Lunaveth live in this folder). Swaps are keyed on the other
       mod's GeneDef existing, not on the mod's name. -->

  <!-- VRE - Lycanthrope loaded: nocturnal instead of Alpha Genes' night owl, even without Alpha
       Genes. The AG_NightOwl li is always in the XML here (MayRequire is only applied when the
       def loads, after patching), so one replace covers both cases; the new li has no MayRequire.
       MMMM only does this swap for specific other mods' xenotypes, not ours. -->
  <Operation Class="PatchOperationConditional">
    <xpath>Defs/GeneDef[defName="VRE_Nocturnal"]</xpath>
    <match Class="PatchOperationReplace">
      <xpath>Defs/XenotypeDef[defName="Lepthera_Lunaveth"]/genes/li[text()="AG_NightOwl"]</xpath>
      <value>
        <li>VRE_Nocturnal</li>
      </value>
    </match>
  </Operation>

</Patch>
