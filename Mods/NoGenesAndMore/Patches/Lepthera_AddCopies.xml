<?xml version="1.0" encoding="utf-8"?>
<Patch>

  <!-- Without Genes &amp; More: our copies of its large frame and venom talons.
       The copies are defined in this same folder, so a xenotype only ever lists them when they
       exist. With the original mod active, the xenotype lists its gene instead (MayRequire). -->

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/XenotypeDef[defName="Lepthera_Aurelith"]/genes</xpath>
    <value>
      <li>Lepthera_LargeFrame</li>
    </value>
  </Operation>

  <Operation Class="PatchOperationAdd">
    <xpath>Defs/XenotypeDef[defName="Lepthera_Noctyra"]/genes</xpath>
    <value>
      <li>Lepthera_VenomTalons</li>
    </value>
  </Operation>

</Patch>
