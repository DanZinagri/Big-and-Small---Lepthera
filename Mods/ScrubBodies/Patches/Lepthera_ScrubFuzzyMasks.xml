<?xml version="1.0" encoding="utf-8"?>
<Patch>

	<!-- Even More Scrubdaddy's Bodies (sd.sd.scrubbody.xenotypes) replaces OAB's adult BP_Fuzzy_Body art
	     at the same paths and ships matching masks next to it (Fuzzy_Body_<type>_<rot>m, red = fluff,
	     green = chitin, same layout as ours). Removing our adult mask paths leaves B&S's Ultimate node
	     with no mask path, so Graphic_Multi falls back to <texture>_<rot>m: their masks.
	     Child/Baby keep ours (the mod has no child art). -->

	<Operation Class="PatchOperationRemove">
		<xpath>Defs/GeneDef[defName="Lepthera_FluffyBody"]/renderNodeProperties/li/conditionalGraphics/maskPaths/Body_Male</xpath>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/GeneDef[defName="Lepthera_FluffyBody"]/renderNodeProperties/li/conditionalGraphics/maskPaths/Body_Female</xpath>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/GeneDef[defName="Lepthera_FluffyBody"]/renderNodeProperties/li/conditionalGraphics/maskPaths/Body_Thin</xpath>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/GeneDef[defName="Lepthera_FluffyBody"]/renderNodeProperties/li/conditionalGraphics/maskPaths/Body_Fat</xpath>
	</Operation>
	<Operation Class="PatchOperationRemove">
		<xpath>Defs/GeneDef[defName="Lepthera_FluffyBody"]/renderNodeProperties/li/conditionalGraphics/maskPaths/Body_Hulk</xpath>
	</Operation>

</Patch>
