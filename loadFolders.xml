<?xml version="1.0" encoding="utf-8"?>

<loadFolders>
	<!-- Root: Defs, Patches and Textures for both versions. Version folders: Lepthera.dll only.
	     Mods/No*: our copies of other mods' genes, loaded only when that mod is NOT active
	     (the xenotype lists the original with MayRequire instead).
	     Mods/GenesAndMore: Lunaveth, which rely on Genes & More.
	     Mods/AlphaGenes: Mycoth, which rely on Alpha Genes.
	     Mods/AlphaGenes_NoFungoid, Mods/AlphaGenes_NoFactionElves: Mycoth's copies, so they also
	     need Alpha Genes (Faction - Elves is 1.6 only).
	     Every copy folder patches its own copies onto the xenotype; the xenotype XML only lists the
	     original mod's gene with MayRequire. So a copy is referenced only when it is loaded.
	     Mods/Atavism*: Atavism Libraries births-as-mother's-xenotype defs (Lunaveth / Mycoth
	     ones also need the mod that defines that xenotype).
	     Mods/IntimacyGenderWorks: Intimacy - Gender Works reproduction part on Lepthera_Body. -->
	<v1.6>
		<li>/</li>
		<li>1.6</li>
		<li IfModNotActive="sarg.alphagenes">Mods/NoAlphaGenes</li>
		<li IfModNotActive="RedMattis.BigSmall.Core">Mods/NoGenesAndMore</li>
		<li IfModActive="RedMattis.BigSmall.Core">Mods/GenesAndMore</li>
		<li IfModActive="RedMattis.BigSmall.Core" IfModNotActive="sarg.alphagenes">Mods/GenesAndMore_NoAlphaGenes</li>
		<li IfModActive="sarg.alphagenes">Mods/AlphaGenes</li>
		<li IfModActive="sarg.alphagenes" IfModNotActive="vanillaracesexpanded.fungoid">Mods/AlphaGenes_NoFungoid</li>
		<li IfModActive="sarg.alphagenes" IfModNotActive="ICC.FOV.ELVES">Mods/AlphaGenes_NoFactionElves</li>
		<li IfModActive="DanZinagri.AtavismLibraries">Mods/Atavism</li>
		<li IfModActiveAll="DanZinagri.AtavismLibraries, RedMattis.BigSmall.Core">Mods/Atavism_GenesAndMore</li>
		<li IfModActiveAll="DanZinagri.AtavismLibraries, sarg.alphagenes">Mods/Atavism_AlphaGenes</li>
		<li IfModActive="LovelyDovey.Sex.WithRosaline">Mods/IntimacyGenderWorks</li>
	</v1.6>
	<v1.7>
		<li>/</li>
		<li>1.7</li>
		<li IfModNotActive="sarg.alphagenes">Mods/NoAlphaGenes</li>
		<li IfModNotActive="RedMattis.BigSmall.Core">Mods/NoGenesAndMore</li>
		<li IfModActive="RedMattis.BigSmall.Core">Mods/GenesAndMore</li>
		<li IfModActive="RedMattis.BigSmall.Core" IfModNotActive="sarg.alphagenes">Mods/GenesAndMore_NoAlphaGenes</li>
		<li IfModActive="sarg.alphagenes">Mods/AlphaGenes</li>
		<li IfModActive="sarg.alphagenes" IfModNotActive="vanillaracesexpanded.fungoid">Mods/AlphaGenes_NoFungoid</li>
		<li IfModActive="sarg.alphagenes" IfModNotActive="ICC.FOV.ELVES">Mods/AlphaGenes_NoFactionElves</li>
		<li IfModActive="DanZinagri.AtavismLibraries">Mods/Atavism</li>
		<li IfModActiveAll="DanZinagri.AtavismLibraries, RedMattis.BigSmall.Core">Mods/Atavism_GenesAndMore</li>
		<li IfModActiveAll="DanZinagri.AtavismLibraries, sarg.alphagenes">Mods/Atavism_AlphaGenes</li>
		<li IfModActive="LovelyDovey.Sex.WithRosaline">Mods/IntimacyGenderWorks</li>
	</v1.7>
</loadFolders>
